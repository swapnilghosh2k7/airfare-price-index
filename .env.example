# AirFareX Environment Configuration Example
# Copy this file to .env before starting the application

AIRFAREX_ENV=development
AIRFAREX_DEMO_MODE=true

# Database Configuration
DATABASE_URL=sqlite:///./airfarex.db
# For PostgreSQL in Docker or production:
# DATABASE_URL=postgresql+asyncpg://airfarex_user:airfarex_secret@postgres:5432/airfarex_db

# API Host & Port
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-in-production-airfarex-key-2026

# Active Provider
DEFAULT_FARE_PROVIDER=mock_provider

# Log Level
LOG_LEVEL=INFO
